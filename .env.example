# Prefer scripts/start-reviewer.ps1 or bash scripts/start-reviewer.sh: generates .env automatically.
# For manual setup, copy this file to .env and replace the password placeholders.
# Keep passwords to letters and digits so they can be embedded safely in the Npgsql connection string.
REVIEWER_DB_ADMIN_PASSWORD=replace_with_random_alphanumeric_secret
REVIEWER_DB_PASSWORD=replace_with_a_different_random_alphanumeric_secret

# Local reviewer tokens, available only with Development and the demo database.
REVIEWER_AUTH_ENABLED=true

# To use an external identity provider, set REVIEWER_AUTH_ENABLED=false and configure all three.
REVIEWER_JWT_AUTHORITY=
REVIEWER_JWT_ISSUER=
REVIEWER_JWT_AUDIENCE=

REVIEWER_API_PORT=5080
